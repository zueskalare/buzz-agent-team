#!/bin/sh
# The workspace wall for an agent on the stock Claude adapter (the supervisor): this stands in for
# claude-agent-acp and makes the adapter run its Claude CLI through walled-claude, beside this file.
# team.sh and agent-team.sh start point the launcher here; BUZZ_WALL_PROJECT names the project folder.
set -eu
wall_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
PROJECT_BUZZ_ADAPTER=$(command -v claude-agent-acp) || { echo 'claude-agent-acp is missing from PATH' >&2; exit 1; }
[ ! "$PROJECT_BUZZ_ADAPTER" -ef "$0" ] || { echo 'PATH must resolve the installed Claude ACP adapter' >&2; exit 1; }
export PROJECT_BUZZ_ADAPTER
# "--cli ARGS" runs the agent's own CLI, as the adapter's --cli does: the sign-in check asks it.
if [ "${1:-}" = --cli ]; then shift; exec "$wall_dir/walled-claude" "$@"; fi
if [ "${1:-}" = --check-wall ]; then exec "$wall_dir/walled-claude" --check-wall; fi
export CLAUDE_CODE_EXECUTABLE="$wall_dir/walled-claude"
# The agent's shell finds wall/bin/buzz first: it runs the real Buzz CLI for a plain buzz command and
# explains itself inside the sandbox, where there is no network.
PATH="$wall_dir/bin:$PATH"
export PATH
exec "$PROJECT_BUZZ_ADAPTER" "$@"
