#!/usr/bin/env python3
"""Launch the adapter's Claude CLI inside the workspace wall.

The agent keeps its tools, but its files stop at the project folder:

- the file tools read and write only inside the project folder
  (permissions.blockReadsOutsideWorkingDirectories, blockWritesOutsideWorkingDirectories), symlinks
  resolved;
- shell commands run in Claude Code's sandbox: they cannot read the user's home folder outside the
  project folder (and the folders BUZZ_WALL_READ names), they write only inside the project folder
  and a temporary folder, and the agent cannot ask to run one outside the sandbox;
- a plain "buzz ..." command is exempt from the sandbox, because the sandbox has no direct network
  and the agent talks to Buzz with that command. A path outside the project folder that such a
  command names needs an approval, and nothing can give one: the session runs in the dontAsk
  permission mode, where whatever would ask is refused. A compound command (a pipe, a list, a
  substitution) runs walled as a whole.

The Buzz harness answers every permission request with "allow", so the wall never relies on one.
The mode is dontAsk with allow rules for the agent's ordinary tools, and the option that would let
a client switch the session to bypassPermissions is dropped.

The user's own Claude settings are not loaded (they can name more folders, which would widen the
wall). The project's own settings are loaded, and a project settings file that names more folders
stops the start. The wall's settings are passed on the command line, over every settings file, and
this program lives outside the project folder, where the walled agent cannot read or change it.

Not covered: network access, and tools of MCP servers the project itself configures.

BUZZ_WALL_PROJECT   the project folder (required for a session; the session must start inside it)
BUZZ_WALL_READ      more folders shell commands may read, separated by ":" (optional)
"""
import json
import os
import subprocess
import sys

adapter = os.environ.get("PROJECT_BUZZ_ADAPTER", "")
if not adapter:
    sys.exit("walled-claude: PROJECT_BUZZ_ADAPTER is not set; start the agent through wall/claude-agent-acp")
os.environ.pop("CLAUDE_CODE_EXECUTABLE", None)
args = sys.argv[1:]


def inside(path, folder):
    return path == folder or path.startswith(folder.rstrip("/") + "/")


def project_folder():
    """The project folder, checked: it exists and is not the home folder or a folder around it."""
    project = os.environ.get("BUZZ_WALL_PROJECT", "")
    if not project or not os.path.isdir(project):
        sys.exit("walled-claude: BUZZ_WALL_PROJECT must name the project folder; start the agent with the team's own command")
    project = os.path.realpath(project)
    home = os.path.realpath(os.path.expanduser("~"))
    if inside(home, project):
        sys.exit(f"walled-claude: the project folder {project} is the home folder or a folder around it; no wall can hold there")
    # Settings files in the project folder are loaded. One that names more folders would widen the wall.
    for name in ("settings.json", "settings.local.json"):
        path = os.path.join(project, ".claude", name)
        try:
            with open(path, encoding="utf-8") as handle:
                data = json.load(handle)
        except FileNotFoundError:
            continue
        except (OSError, ValueError):
            sys.exit(f"walled-claude: {path} cannot be read as JSON; fix or remove it, since the wall cannot tell what it allows")
        extra = (data.get("permissions") or {}).get("additionalDirectories") if isinstance(data, dict) else None
        if extra:
            sys.exit(f"walled-claude: {path} names more folders (permissions.additionalDirectories); remove that entry, or the wall would not hold")
    return project, home


if args == ["--check-wall"]:
    try:
        help_text = subprocess.check_output([adapter, "--cli", "--help"], stdin=subprocess.DEVNULL, text=True, timeout=15)
    except (subprocess.SubprocessError, OSError) as exc:
        sys.exit(f"The wall check failed: the Claude CLI did not answer ({exc}).")
    for option in ("--settings", "--setting-sources", "--permission-mode"):
        if option not in help_text:
            sys.exit(f"The wall needs a Claude CLI that takes {option}; update the Claude ACP adapter.")
    if sys.platform == "darwin" and not os.access("/usr/bin/sandbox-exec", os.X_OK):
        sys.exit("The wall needs the macOS sandbox (/usr/bin/sandbox-exec), which is missing.")
    project_folder()
    sys.exit(0)

if args in (["--version"], ["-v"], ["--help"]) or args[:2] == ["auth", "status"]:
    # Questions about the CLI and its sign-in: no session, so no wall is needed.
    os.execv(adapter, [adapter, "--cli", *args])

project, home = project_folder()
cwd = os.path.realpath(os.getcwd())
if not inside(cwd, project):
    sys.exit(f"walled-claude: this session starts in {cwd}, outside the project folder {project}; refused")

# Shell commands may read the project folder and wall/bin, which holds only the buzz stand-in.
readable = [project, os.path.join(os.path.dirname(os.path.realpath(__file__)), "bin")]
for extra in os.environ.get("BUZZ_WALL_READ", "").split(":"):
    if extra and os.path.isabs(extra) and os.path.isdir(extra):
        extra = os.path.realpath(extra)
        if not inside(home, extra) and extra not in readable:
            readable.append(extra)

wall = {
    "permissions": {
        "defaultMode": "dontAsk",
        "blockReadsOutsideWorkingDirectories": True,
        "blockWritesOutsideWorkingDirectories": True,
        # In dontAsk, a tool that would ask is refused; these are the tools the agent may use freely.
        # "Bash" allows shell commands: they run in the sandbox, which is what holds them, and the
        # exempt Buzz command is still refused a path outside the project folder (test-wall.py).
        "allow": ["Edit", "Write", "NotebookEdit", "WebFetch", "WebSearch", "Bash"],
    },
    "sandbox": {
        "enabled": True,
        "failIfUnavailable": True,
        "allowUnsandboxedCommands": False,
        "autoAllowBashIfSandboxed": True,
        "filesystem": {"denyRead": ["~/"], "allowRead": readable},
        "excludedCommands": ["buzz *"],
    },
}


def merge(base, over):
    """Settings from the adapter, with the wall's values over them."""
    out = dict(base)
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = merge(out[key], value)
        else:
            out[key] = value
    return out


def load(value):
    """A --settings value: JSON text, or the path of a JSON file."""
    try:
        data = json.loads(value)
    except ValueError:
        try:
            with open(value, encoding="utf-8") as handle:
                data = json.load(handle)
        except (OSError, ValueError):
            return {}
    return data if isinstance(data, dict) else {}


# A test can ask for the option names the adapter passed (no values): BUZZ_WALL_ARGS_LOG=<file>.
if os.environ.get("BUZZ_WALL_ARGS_LOG"):
    with open(os.environ["BUZZ_WALL_ARGS_LOG"], "a", encoding="utf-8") as handle:
        handle.write(" ".join(a if a.startswith("-") else "<value>" for a in args) + "\n")

# The adapter's own choices that would widen the wall are replaced; its --settings go under the wall's.
VALUE = {"--permission-mode", "--setting-sources"}
FLAG = {"--allow-dangerously-skip-permissions", "--dangerously-skip-permissions"}
kept, given = [], {}
index = 0
while index < len(args):
    arg = args[index]
    name, equals, value = arg.partition("=")
    index += 1
    if name == "--settings":
        if not equals and index < len(args):
            value = args[index]
            index += 1
        given = merge(given, load(value))
    elif name == "--add-dir":
        if not equals:
            while index < len(args) and not args[index].startswith("-"):
                index += 1
    elif name in VALUE:
        if not equals:
            index += 1
    elif name not in FLAG:
        kept.append(arg)

settings = merge(given, wall)
settings["permissions"].pop("additionalDirectories", None)
sources = os.environ.get("BUZZ_WALL_SOURCES", "project,local")  # a test may narrow it
os.execv(adapter, [adapter, "--cli", *kept, "--permission-mode", "dontAsk", "--setting-sources", sources,
                   "--settings", json.dumps(settings)])
