#!/bin/sh
set -eu
runtime_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
PROJECT_BUZZ_ADAPTER=$(command -v claude-agent-acp) || { echo 'claude-agent-acp is missing from PATH' >&2; exit 1; }
PROJECT_BUZZ_CLI=$(command -v buzz) || { echo 'buzz is missing from PATH' >&2; exit 1; }
[ ! "$PROJECT_BUZZ_ADAPTER" -ef "$0" ] || { echo 'PATH must resolve the installed Claude ACP adapter' >&2; exit 1; }
export PROJECT_BUZZ_ADAPTER PROJECT_BUZZ_CLI
unset BUZZ_PRIVATE_KEY BUZZ_AUTH_TAG RUN_BUZZ_ACP_KEY_FILE
# "--cli ARGS" runs the partner's own CLI, as the adapter's --cli does: the sign-in check asks it.
if [ "${1:-}" = --cli ]; then shift; exec "$runtime_dir/restricted-claude" "$@"; fi
export CLAUDE_CODE_EXECUTABLE="$runtime_dir/restricted-claude"
"$runtime_dir/restricted-claude" --check-runtime || exit 1
[ "${1:-}" != --check-runtime ] || exit 0
exec "$PROJECT_BUZZ_ADAPTER" "$@"
