#!/usr/bin/env node
// Read project context, discuss proposals, keep the agent's private memory and, for the channel supervisor,
// manage channels. Each tool supplies a fixed argv to the installed CLI.
const { createRequire } = require("node:module");
const { spawnSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const deps = createRequire(fs.realpathSync(process.env.PROJECT_BUZZ_ADAPTER));
const { McpServer } = deps("@modelcontextprotocol/sdk/server/mcp.js");
const { StdioServerTransport } = deps("@modelcontextprotocol/sdk/server/stdio.js");
const { z } = deps("zod");
if (process.argv[2] === "--check-runtime") process.exit(0);
const server = new McpServer({ name: "buzz", version: "1.0.0" });
const agentDir = process.env.PROJECT_BUZZ_AGENT_DIR || path.resolve(__dirname, "..");
const cli = process.env.PROJECT_BUZZ_CLI;

function credential(name) {
  const lines = fs.readFileSync(path.join(agentDir, ".env.buzz-acp.local"), "utf8").split(/\r?\n/);
  const pattern = new RegExp("^\\s*(?:export\\s+)?" + name + "\\s*=\\s*(.*?)\\s*$");
  const matches = lines.map(line => line.match(pattern)).filter(Boolean);
  if (matches.length !== 1) throw new Error("The agent’s local Buzz configuration is incomplete");
  const value = matches[0][1];
  if (!/^['"]/.test(value)) return value;
  if (value.length < 2 || value.at(-1) !== value[0]) throw new Error("Invalid quoted Buzz setting");
  return value.slice(1, -1);
}

function buzz(args, input) {
  const env = {
    HOME: os.homedir(), PATH: process.env.PATH,
    BUZZ_RELAY_URL: credential("BUZZ_RELAY_URL"), BUZZ_AUTH_TAG: credential("BUZZ_AUTH_TAG"),
    BUZZ_PRIVATE_KEY: fs.readFileSync(path.join(agentDir, "identity.key"), "utf8").trim()
  };
  const result = spawnSync(cli, ["--format", "agent", ...args], {
    env, input, encoding: "utf8", maxBuffer: 1024 * 1024, timeout: 20000
  });
  if (result.error) throw new Error("Buzz command failed: " + (result.error.code || "execution error"));
  if (result.status !== 0) throw new Error("Buzz rejected the request (exit " + result.status + ")");
  return result.stdout;
}

const channel = z.string().uuid();
const event = z.string().regex(/^[0-9a-f]{64}$/);
const slug = z.string().max(256).regex(/^(?:core|(?:mem\/)?[a-z0-9][a-z0-9_./-]*)$/);
const limit = z.number().int().min(1).max(50).default(20);
const message = z.string().min(1).max(32000);
function tool(name, description, inputSchema, run) {
  server.registerTool(name, {description, inputSchema}, async args => ({
    content: [{ type: "text", text: run(args) || "(empty)" }]
  }));
}

// Codex receives project reads through this server. Resolve symlinks before
// checking containment and bound both the directory result and each file read.
if (process.env.PROJECT_BUZZ_WORKSPACE) {
  const root = fs.realpathSync(process.env.PROJECT_BUZZ_WORKSPACE);
  function projectPath(relative) {
    const target = fs.realpathSync(path.resolve(root, relative));
    const within = path.relative(root, target);
    if (within === ".." || within.startsWith(".." + path.sep) || path.isAbsolute(within)) {
      throw new Error("Path is outside the project");
    }
    return target;
  }
  tool("list_project", "List up to 200 entries in a project directory.",
    {path: z.string().max(2048).default(".")}, a => {
      const dir = fs.opendirSync(projectPath(a.path));
      const entries = [];
      try {
        for (let entry; entries.length < 200 && (entry = dir.readSync()); ) {
          entries.push(entry.name + (entry.isDirectory() ? "/" : ""));
        }
      } finally { dir.closeSync(); }
      return entries.join("\n");
    });
  tool("read_project", "Read up to 64 KiB of a project text file at a byte offset.",
    {path: z.string().min(1).max(2048), offset: z.number().int().nonnegative().default(0)}, a => {
      const target = projectPath(a.path);
      const fd = fs.openSync(target, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
      try {
        if (!fs.fstatSync(fd).isFile()) throw new Error("Select a regular file");
        const buffer = Buffer.alloc(65536);
        const count = fs.readSync(fd, buffer, 0, buffer.length, a.offset);
        return buffer.toString("utf8", 0, count);
      } finally { fs.closeSync(fd); }
    });
}

tool("read_channel", "Read recent messages in a joined Buzz channel.", {channel, limit},
  a => buzz(["messages", "get", "--channel", a.channel, "--limit", String(a.limit)]));
tool("read_thread", "Read the thread containing a message.", {channel, event, limit},
  a => buzz(["messages", "thread", "--channel", a.channel, "--event", a.event, "--limit", String(a.limit)]));
tool("search_messages", "Find prior discussions visible to this agent.", {query: z.string().min(1).max(300), limit},
  a => buzz(["messages", "search", "--query="+a.query, "--limit", String(a.limit)]));
tool("read_canvas", "Read the channel canvas.", {channel},
  a => buzz(["canvas", "get", "--channel", a.channel]));
tool("read_issue", "Read a Buzz issue by its event ID.", {event},
  a => buzz(["issues", "get", "--event", a.event]));
tool("list_issues", "Read issues on a Buzz repository board.", {
  repo_owner: event, repo_id: z.string().min(1).max(255), limit
}, a => buzz(["issues", "list", "--repo-owner", a.repo_owner, "--repo-id="+a.repo_id, "--limit", String(a.limit)]));
tool("post_message", "Publish a Buzz message or a proposed todo. Use the supplied thread destination for replies.", {
  channel, text: message, reply_to: event.optional(), mentions: z.array(event).max(8).default([])
}, a => {
  const args = ["messages", "send", "--channel", a.channel, "--content", "-"];
  if (a.reply_to) args.push("--reply-to", a.reply_to);
  for (const key of a.mentions) args.push("--mention", key);
  return buzz(args, a.text);
});
tool("list_memory", "List the agent’s personal Buzz memory.", {}, () => buzz(["mem", "ls", "--json"]));
tool("read_memory", "Retrieve one of the agent’s saved notes.", {slug}, a => buzz(["mem", "get", a.slug]));
tool("save_memory", "Save a personal Buzz note. Read an existing note before replacing it.", {
  slug, text: z.string().min(1).max(64000)
}, a => buzz(["mem", "set", a.slug, "-"], a.text));

// The channel supervisor alone also creates and manages channels. Its role is the role= line of agent.conf
// in its folder, read as agent-team.sh reads it (the first such line). Any other role, or a file that is
// missing or unreadable, registers none of these tools. There is no tool to delete or leave a channel, or
// to change its join role, auto-join or add policy; the relay decides what this agent's channel role allows.
function agentRole() {
  try {
    const line = fs.readFileSync(path.join(agentDir, "agent.conf"), "utf8").split("\n").find(l => l.startsWith("role="));
    return line === undefined ? null : line.slice("role=".length);
  } catch { return null; }
}
if (agentRole() === "supervisor") {
  // Free text goes as one --flag=value argument, so a value can never be read as an option.
  const name = z.string().min(1).max(80).regex(/^[^\u0000-\u001f\u007f-\u009f]+$/);
  const text = z.string().max(1000);
  const ttl = z.number().int().min(60).max(365 * 24 * 3600);
  const visibility = z.enum(["open", "private"]);
  const pubkey = event;
  tool("list_channels", "List the Buzz channels visible to this agent.", {}, () => buzz(["channels", "list"]));
  tool("get_channel", "Read a Buzz channel’s settings.", {channel},
    a => buzz(["channels", "get", "--channel", a.channel]));
  tool("list_channel_members", "List a Buzz channel’s members and their roles.", {channel},
    a => buzz(["channels", "members", "--channel", a.channel]));
  tool("create_channel", "Create a Buzz channel, private unless visibility is open. ttl_seconds makes it " +
    "temporary: the relay archives it after that many seconds without a message.", {
    name, type: z.enum(["stream", "forum"]).default("stream"), visibility: visibility.default("private"),
    description: text.optional(), ttl_seconds: ttl.optional(), unlisted: z.boolean().default(false)
  }, a => {
    const args = ["channels", "create", "--name=" + a.name, "--type", a.type, "--visibility", a.visibility];
    if (a.description !== undefined) args.push("--description=" + a.description);
    if (a.ttl_seconds !== undefined) args.push("--ttl", String(a.ttl_seconds));
    if (a.unlisted) args.push("--unlisted");
    return buzz(args);
  });
  tool("update_channel", "Change a channel’s name, description, visibility or lifetime. ttl_seconds makes it " +
    "temporary; permanent: true makes it permanent.", {
    channel, name: name.optional(), description: text.optional(), visibility: visibility.optional(),
    ttl_seconds: ttl.optional(), permanent: z.boolean().optional()
  }, a => {
    if (a.ttl_seconds !== undefined && a.permanent !== undefined) throw new Error("Give ttl_seconds or permanent, not both");
    const args = ["channels", "update", "--channel", a.channel];
    if (a.name !== undefined) args.push("--name=" + a.name);
    if (a.description !== undefined) args.push("--description=" + a.description);
    if (a.visibility !== undefined) args.push("--visibility", a.visibility);
    if (a.ttl_seconds !== undefined) args.push("--ttl", String(a.ttl_seconds));
    if (a.permanent) args.push("--no-ttl");
    if (args.length === 4) throw new Error("Nothing to change");
    return buzz(args);
  });
  tool("set_channel_topic", "Set a channel’s topic.", {channel, topic: text},
    a => buzz(["channels", "topic", "--channel", a.channel, "--topic=" + a.topic]));
  tool("set_channel_purpose", "Set a channel’s purpose.", {channel, purpose: text},
    a => buzz(["channels", "purpose", "--channel", a.channel, "--purpose=" + a.purpose]));
  tool("add_channel_member", "Add a person or agent to a channel as a member, bot or guest.", {
    channel, pubkey, role: z.enum(["member", "bot", "guest"]).default("member")
  }, a => buzz(["channels", "add-member", "--channel", a.channel, "--pubkey", a.pubkey, "--role", a.role]));
  tool("remove_channel_member", "Remove a person or agent from a channel.", {channel, pubkey},
    a => buzz(["channels", "remove-member", "--channel", a.channel, "--pubkey", a.pubkey]));
  tool("archive_channel", "Archive a channel.", {channel}, a => buzz(["channels", "archive", "--channel", a.channel]));
  tool("unarchive_channel", "Unarchive a channel.", {channel},
    a => buzz(["channels", "unarchive", "--channel", a.channel]));
}
server.connect(new StdioServerTransport()).catch(error => { console.error(error.message); process.exitCode = 1; });
