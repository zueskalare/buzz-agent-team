#!/usr/bin/env python3
"""Run the channel discussion partner through Codex ACP with only its typed MCP tools."""
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import threading

HERE = Path(__file__).resolve().parent
MAX_FRAME = 16 * 1024 * 1024
# These are user-configurable in a normal Codex session. A channel member must
# never acquire a local execution tool or an unrelated personal connector.
DISABLED = (
    "shell_tool", "view_image", "image_generation", "computer_use", "browser_use",
    "apps", "plugins", "hooks", "code_mode", "multi_agent", "multi_agent_v2",
    "js_repl", "tool_search", "memories", "skill_search", "goals", "memory_tool", "request_permissions_tool",
)
BUZZ_SERVER = "buzz_discussion"

def executable(name):
    path = shutil.which(name)
    if not path:
        sys.exit(f"Missing executable: {name}")
    return path

def codex_server():
    """Constrain both thread startup and turn overrides from the stock ACP adapter."""
    cli = os.environ["PROJECT_BUZZ_CODEX_CLI"]
    with tempfile.TemporaryDirectory(prefix="buzz-codex-partner-") as work:
        # Share the Codex login in place. Project config cannot add tools in this empty cwd.
        args = [cli, "app-server"]
        def setting(key, value):
            args.extend(["-c", f"{key}={json.dumps(value)}"])
        # Some Codex models opt into code-mode tools independently of the feature
        # switches. Use the same models and account with a role-specific tool catalog.
        catalog = json.loads(subprocess.check_output([cli, "debug", "models", "--bundled"],
                                                     cwd=work, timeout=15))
        for model in catalog["models"]:
            model.update(tool_mode=None, experimental_supported_tools=[], node_repl_disabled=True,
                         apply_patch_tool_type=None, supports_search_tool=False, shell_type="disabled")
            model.pop("multi_agent_version", None)
            model.pop("multi_agent_reasoning_effort", None)
        catalog_path = Path(work) / "partner-models.json"
        catalog_path.write_text(json.dumps(catalog))
        setting("model_catalog_json", str(catalog_path))
        for feature in DISABLED:
            setting("features." + feature, False)
        for key, value in {
            "web_search": "disabled", "skills.include_instructions": False,
            "sandbox_mode": "read-only", "approval_policy": "never",
            "model_provider": "openai", "forced_login_method": "chatgpt",
            "project_doc_max_bytes": 0, "features.skip_host_skill_discovery": True,
        }.items():
            setting(key, value)
        servers = json.loads(subprocess.check_output(
            [cli, "mcp", "list", "--json", *args[2:]], cwd=work, timeout=20))
        names = [server["name"] for server in servers]
        if BUZZ_SERVER in names:
            sys.exit(f"{BUZZ_SERVER} is reserved for the Buzz partner")
        if names:
            # CLI dotted keys split literally. A TOML inline table also handles
            # user-defined server names containing dots or quotes.
            disabled = ", ".join(json.dumps(name) + "={enabled=false}" for name in names)
            args.extend(["-c", "mcp_servers={" + disabled + "}"])
        prefix = "mcp_servers." + BUZZ_SERVER
        setting(prefix + ".command", str(HERE / "buzz-tools"))
        setting(prefix + ".required", True)
        # buzz-tools registers the channel tools for the channel supervisor only (agent.conf role=supervisor);
        # for a reviewer they do not exist, so enabling them here gives it nothing.
        tools = ["list_project", "read_project", "read_channel", "read_thread", "search_messages",
                 "read_canvas", "read_issue", "list_issues", "post_message", "list_memory",
                 "read_memory", "save_memory", "list_channels", "get_channel", "list_channel_members",
                 "create_channel", "update_channel", "set_channel_topic", "set_channel_purpose",
                 "add_channel_member", "remove_channel_member", "archive_channel", "unarchive_channel"]
        setting(prefix + ".enabled_tools", tools)
        for tool in tools:
            setting(prefix + ".tools." + tool + ".approval_mode", "approve")
        for key in ("PROJECT_BUZZ_AGENT_DIR", "PROJECT_BUZZ_WORKSPACE",
                    "PROJECT_BUZZ_CLI", "PROJECT_BUZZ_ADAPTER"):
            setting(prefix + ".env." + key, os.environ[key])
        args.extend(["-c", "projects={" + json.dumps(work) + '={trust_level="trusted"}}'])

        models = {model["slug"] for model in catalog["models"]}
        proc = subprocess.Popen(args, stdin=subprocess.PIPE, cwd=work)
        def forward():
            source = os.fdopen(os.dup(0), "rb")
            try:
                while True:
                    line = source.readline(MAX_FRAME + 1)
                    if not line:
                        break
                    if len(line) > MAX_FRAME:
                        raise ValueError("Codex request exceeds the frame limit")
                    msg = json.loads(line)
                    method = msg.get("method")
                    p = msg.get("params") or {}
                    if method in ("thread/start", "thread/resume"):
                        p.update(cwd=work, approvalPolicy="never", sandbox="read-only",
                                 modelProvider="openai", config={}, runtimeWorkspaceRoots=[])
                        if method == "thread/start":
                            p.update(environments=[], dynamicTools=[], selectedCapabilityRoots=[])
                    elif method == "turn/start":
                        if p.get("model") and p["model"] not in models:
                            raise ValueError("model is outside the discussion catalog")
                        p.update(cwd=work, approvalPolicy="never", environments=[],
                                 sandboxPolicy={"type": "readOnly", "networkAccess": False})
                    elif method in ("thread/fork", "review/start", "command/exec", "account/logout",
                                    "config/value/write", "config/batchWrite", "account/login/start"):
                        raise ValueError(f"unsupported discussion operation {method}")
                    elif method == "config/read":
                        p["cwd"] = work
                    elif method == "skills/extraRoots/set":
                        p["extraRoots"] = []
                    if "params" in msg:
                        msg["params"] = p
                    proc.stdin.write(json.dumps(msg, separators=(",", ":")).encode() + b"\n")
                    proc.stdin.flush()
            except (OSError, ValueError) as exc:
                print(f"Codex discussion transport stopped: {type(exc).__name__}: {str(exc)[:200]}", file=sys.stderr)
                proc.terminate()
            finally:
                source.close()
                proc.stdin.close()
        reader = threading.Thread(target=forward, daemon=True)
        reader.start()
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, lambda *_: proc.terminate())
        return proc.wait()

def main():
    if sys.argv[1:] == ["app-server"]:
        return codex_server()
    adapter = executable("codex-acp")
    if Path(adapter).samefile(__file__):
        sys.exit("PATH must resolve the installed Codex ACP adapter")
    deps = Path.home() / ".local/share/buzz-agent-team"
    private_cli = deps / "node_modules/.bin/codex"
    cli = str(private_cli) if private_cli.is_file() else executable("codex")
    version = subprocess.check_output([adapter, "--version"], text=True, timeout=10).strip()
    if version.split()[-1] != "1.13.1":
        sys.exit("Buzz requires @agentclientprotocol/codex-acp@1.13.1 for ACP negotiation.")
    env = {k: os.environ[k] for k in ("PATH", "HOME", "TMPDIR", "CODEX_HOME", "LANG",
                                        "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS") if k in os.environ}
    # Resolve the SDK independently of Claude when the private npm runtime is installed.
    sdk_anchor = str(deps / "package.json") if private_cli.is_file() else (shutil.which("claude-agent-acp") or adapter)
    env.update(PROJECT_BUZZ_ADAPTER=sdk_anchor, PROJECT_BUZZ_CODEX_CLI=cli,
               PROJECT_BUZZ_CLI=executable("buzz"))
    subprocess.run([HERE / "buzz-tools", "--check-runtime"], env=env, check=True, timeout=10)
    cli_version = subprocess.check_output([cli, "--version"], env=env, text=True, timeout=10).split()[-1]
    if cli_version != "0.171.0":
        sys.exit(f"Discussion tool policy is verified with codex-cli 0.171.0 (found {cli_version}).")
    if sys.argv[1:] == ["--check-runtime"]:
        return 0
    if sys.argv[1:] == ["--sign-in-status"]:
        # The same CLI and CODEX_HOME the partner's app-server uses; prints e.g. "Logged in using ChatGPT".
        status = subprocess.run([cli, "login", "status"], env=env, text=True, capture_output=True, timeout=30)
        sys.stdout.write(status.stdout + status.stderr)
        return status.returncode
    agent_dir = os.environ.get("PROJECT_BUZZ_AGENT_DIR") or str(HERE.parent)
    env.update(PROJECT_BUZZ_AGENT_DIR=agent_dir, PROJECT_BUZZ_WORKSPACE=os.getcwd(),
               CODEX_PATH=str(Path(__file__).resolve()), INITIAL_AGENT_MODE="read-only")
    os.execve(adapter, [adapter, *sys.argv[1:]], env)

if __name__ == "__main__":
    sys.exit(main())
